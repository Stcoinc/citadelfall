# Normalize text files
* text=auto

# Unity YAML assets should stay mergeable text
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.asmdef text eol=lf

# Common Unity binary assets are stored directly in Git for this project.
*.png !text !filter !merge !diff
*.jpg !text !filter !merge !diff
*.jpeg !text !filter !merge !diff
*.psd !text !filter !merge !diff
*.tga !text !filter !merge !diff
*.tif !text !filter !merge !diff
*.tiff !text !filter !merge !diff
*.gif !text !filter !merge !diff
*.bmp !text !filter !merge !diff
*.mp3 !text !filter !merge !diff
*.wav !text !filter !merge !diff
*.ogg !text !filter !merge !diff
*.fbx !text !filter !merge !diff
*.blend !text !filter !merge !diff
*.glb !text !filter !merge !diff
*.gltf !text !filter !merge !diff
*.mp4 !text !filter !merge !diff
*.mov !text !filter !merge !diff
*.webm !text !filter !merge !diff
*.ttf !text !filter !merge !diff
*.otf !text !filter !merge !diff
